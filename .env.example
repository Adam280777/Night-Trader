# Copy to .env.local for local use. On Vercel, set these in Project > Settings > Environment Variables.
# Never commit .env.local.

# --- Required on Vercel ---
# Hosted database (create a free one at turso.tech). Leave both empty locally to use a SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# (The Turso integration in Vercel names these STORAGE_TURSO_DATABASE_URL / STORAGE_TURSO_AUTH_TOKEN; those work too.)
# Password for the dashboard login (seeds the stored password on first start; change it later in Settings)
APP_PASSWORD=
# Encrypts the API keys you save in Settings. Any long random string; keep it stable or saved keys become unreadable.
SECRETS_KEY=
# Protects /api/cron/tick. Any random string of 16+ characters; the external timer sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# --- Optional ---
# Local database file (only used when TURSO_DATABASE_URL is empty)
DATABASE_PATH=./data/trader.db
# API keys can be added in the app under Settings; these are only a fallback.
T212_API_KEY=
T212_API_SECRET=
T212_ENV=demo
# Financial Modeling Prep Starter key for real-time US quotes and event calendars.
FMP_API_KEY=
# Optional operator-owned webhook. Critical errors are sent as JSON and deduplicated for 30 minutes.
ALERT_WEBHOOK_URL=
# Optional bearer token for /api/health. Configure an external uptime monitor to alert on non-200 responses.
HEALTH_SECRET=
# No AI provider keys are needed. Decisions are made by the model built into the app,
# and market data comes from FMP plus Yahoo Finance, which requires no key.
