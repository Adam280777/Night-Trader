# Copy to .env.local and fill in. Never commit .env.local.

# Trading 212 API credentials (generate in the T212 app: Settings > API).
# Use a DEMO (practice) account key first.
T212_API_KEY=
T212_API_SECRET=
# demo | live  (live also requires the typed confirmation in Settings)
T212_ENV=demo

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# SQLite file location
DATABASE_PATH=./data/trader.db

# Password for the dashboard login (seeds the stored password on first start; change it later in Settings)
APP_PASSWORD=
# Optional: encryption key for keys saved in Settings (otherwise a random key file is created beside the database)
SECRETS_KEY=
